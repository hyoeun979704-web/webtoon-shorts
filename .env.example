# Google Sheets URL
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# OpenAI API 키 (필수)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 모델 (기본: gpt-4o)
OPENAI_MODEL=gpt-4o

# DALL-E 이미지 모델 (기본: dall-e-3)
DALLE_MODEL=dall-e-3

# 브라우저 자동화 (CapCut 편집용)
BROWSER_PROFILE_DIR=./browser_data
